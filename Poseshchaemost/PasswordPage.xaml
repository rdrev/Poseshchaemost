<Page x:Class="Poseshchaemost.PasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Poseshchaemost"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PasswordPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="введите пароль" Grid.Column="1" Grid.Row="1"  HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
        <PasswordBox x:Name="PasswordBox1" Grid.Column="2" Grid.Row="2" HorizontalAlignment="Left" Margin="5,5,5,5" VerticalAlignment="Center" Width="120" Background="#FF393C3E" Foreground="White"/>
        <Label Content="повторите пароль" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
        <PasswordBox x:Name="PasswordBox2" Grid.Column="2" Grid.Row="1" HorizontalAlignment="Left" Margin="5,5,5,5" VerticalAlignment="Center" Width="120" Background="#FF393C3E" Foreground="White"/>
        <Button x:Name="BackButton" Content="Отмена" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" Margin="5,5,15,5" VerticalAlignment="Top" Width="120" Click="BackButton_Click"  Background="#FF393C3E" Foreground="White"/>
        <Button x:Name="OkButton" Content="ОК" Grid.Column="2" Grid.Row="3" HorizontalAlignment="Left" Margin="5,5,5,5" VerticalAlignment="Top" Width="120" Click="OkButton_Click"  Background="#FF393C3E" Foreground="White"/>

    </Grid>
</Page>
